---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="VMTR01 — Vireal" description="VMTR01 is a multichannel USB audio recorder for Android.">
  <p class="eyebrow">VMTR01</p>
  <h1>Multichannel USB audio recording on Android.</h1>
  <p class="lede">
    VMTR01 is an Android project for recording multichannel audio from compatible USB audio devices,
    with an initial focus on the Teenage Engineering TX-6.
  </p>
  <div class="actions">
    <a class="button primary" href="https://github.com/vireal01">GitHub</a>
    <a class="button" href="/vmtr01/privacy/">Privacy</a>
    <a class="button" href="/vmtr01/support/">Support</a>
  </div>

  <section class="section prose">
    <h2>What it does</h2>
    <p>
      The project explores direct USB audio capture on Android, device compatibility,
      multichannel recording, visualization and reliable file writing on real hardware.
    </p>

    <h2>Project status</h2>
    <p>
      Active development. Store and release links will be added here when public builds are available.
    </p>
  </section>
</BaseLayout>
