---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="VMTR01 Support — Vireal" description="Support information for VMTR01.">
  <div class="prose">
    <p class="eyebrow">VMTR01</p>
    <h1>Support</h1>
    <p>
      VMTR01 is currently in development. For questions, bug reports or compatibility feedback,
      use the project's GitHub presence until a dedicated support channel is published.
    </p>
    <div class="actions">
      <a class="button primary" href="https://github.com/vireal01">Open GitHub</a>
    </div>
  </div>
</BaseLayout>
