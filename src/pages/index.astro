---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Vireal — software projects and experiments">
  <p class="eyebrow">Software · Audio · Android</p>
  <h1>Small tools for real hardware.</h1>
  <p class="lede">
    Vireal is a home for software projects and experiments by Vsevolod Koshmiakov,
    with a focus on Android, audio, hardware integration and developer tooling.
  </p>
  <div class="actions">
    <a class="button primary" href="/projects/">View projects</a>
    <a class="button" href="https://github.com/vireal01">GitHub</a>
  </div>

  <section class="section">
    <p class="eyebrow">Featured project</p>
    <div class="grid">
      <a class="card" href="/vmtr01/">
        <h2>VMTR01</h2>
        <p>Multichannel USB audio recorder for Android.</p>
        <p class="meta">Android · Kotlin · USB Audio</p>
      </a>
    </div>
  </section>
</BaseLayout>
