---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Vireal — software projects and experiments by Vsevolod Koshmiakov.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="header">
        <a class="brand" href="/">vireal.dev</a>
        <nav class="nav" aria-label="Primary navigation">
          <a href="/projects/">Projects</a>
          <a href="https://github.com/vireal01">GitHub</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="footer">© {new Date().getFullYear()} Vireal</footer>
    </div>
  </body>
</html>
